{
  "model": {
    "vocab_size": 512,
    "context_length": 32,
    "d_model": 64,
    "n_layers": 2,
    "n_heads": 4,
    "d_ff": 192
  },
  "train": {
    "steps": 40,
    "batch_size": 4,
    "grad_accum": 1,
    "learning_rate": 0.003,
    "min_lr_ratio": 0.1,
    "warmup_steps": 4,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 10,
    "eval_batches": 4,
    "seed": 42
  }
}
